# Copy this file to .env for local testing, or paste these as "Environment
# Variables" / "Secrets" in your host's dashboard (Render, Railway, etc).
# Never commit a real .env file.

PORT=8787
# The exact origin your storefront is served from, e.g. https://hacklearnraj.in
# Use * only while testing locally.
FRONTEND_ORIGIN=*
# Public URL this backend will be reachable at once deployed, no trailing slash.
# Used to build the download links put in delivery emails.
PUBLIC_BASE_URL=https://pay.hacklearnraj.in
SITE_NAME=HackLearn Press

# ---------------------------------------------------------------- Razorpay
# From Razorpay Dashboard -> Settings -> API Keys (once your account is approved).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard -> Settings -> Webhooks, when you add this backend's
# /api/webhooks/razorpay URL as a webhook subscribed to "payment.captured".
# This is a secret YOU invent when creating the webhook, not something Razorpay gives you first.
RAZORPAY_WEBHOOK_SECRET=

# -------------------------------------------------------------------- Tron
# Your USDT TRC20 receiving address (starts with T...).
# Already wired in as the default in src/server.js (TMf2iM2QqPd57N7XsXVoZuaFKYKMQvrFbz) —
# leave this blank to use that address, or set it here only if you switch wallets later.
TRON_USDT_ADDRESS=
# Optional, raises your free TronGrid rate limit. Get one free at https://www.trongrid.io/
TRONGRID_API_KEY=
# Manually-set INR per USDT rate used only to quote crypto order amounts.
# Update this every so often to track the real rate (no live FX API dependency).
USDT_INR_RATE=90
# How long a paid order's download link stays valid.
DOWNLOAD_LINK_VALID_DAYS=30

# --------------------------------------------------------------- UPI (manual)
# Stopgap until Razorpay is approved: shows your real personal/business UPI ID
# as a QR + link on checkout. The customer uploads a screenshot + UTR, and you
# approve it yourself on /admin.html (see README) — this is NOT automatically
# verified the way Razorpay/crypto are, since a screenshot proves nothing by
# itself. Leave UPI_VPA blank to hide this payment option entirely.
UPI_VPA=
UPI_PAYEE_NAME=HackLearn Press

# --------------------------------------------------------------------- SMTP
# Any SMTP provider works: Gmail (use an App Password), Zoho Mail, SendGrid,
# Resend's SMTP endpoint, Brevo, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HackLearn Press <orders@hacklearnraj.in>

# -------------------------------------------------------------------- admin
# A long random string you invent, used to call the /api/admin/* endpoints
# (manual order confirm, order list) from curl or a tiny admin page.
ADMIN_API_KEY=

# Where the SQLite order database lives. Point this at a persistent disk if
# your host offers one (see README).
DATA_DIR=./data
# Where the 18 book PDFs live (defaults to the pdfs/ folder shipped in this repo).
PDF_DIR=./pdfs
